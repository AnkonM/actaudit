{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActAudit Case Library",
  "description": "Documentation of data/cases/cases.json. Enforced in Python by analysis/case_library.py (load_cases), which tests/test_case_library.py runs; this file is not used at runtime.",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "schema": {"type": "string"},
    "accessed": {"type": "string", "description": "Date the sources were last checked (YYYY-MM-DD)."},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "date", "jurisdiction", "fixture", "system_description", "what_happened", "harm", "what_followed", "sources", "unverified"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "title": {"type": "string"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "When the incident became public (YYYY-MM)."},
          "jurisdiction": {"type": "string"},
          "fixture": {"type": "string", "description": "tests/fixtures stem: text__case_<id>."},
          "system_description": {"type": "string", "description": "Neutral description of the system (not the outcome), 100-150 words; recorded through the normal pipeline."},
          "what_happened": {"type": "string"},
          "harm": {"type": "string"},
          "what_followed": {"type": "string", "description": "Fines, bans, rulings, withdrawal."},
          "sources": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["title", "publisher", "url", "accessed"],
              "properties": {"title": {"type": "string"}, "publisher": {"type": "string"},
                             "url": {"type": "string", "pattern": "^https://"}, "accessed": {"type": "string"}}
            }
          },
          "unverified": {"type": "array", "items": {"type": "string"}, "description": "Facts that could not be verified; shown as unverified in the UI and listed in the report."}
        }
      }
    }
  }
}
